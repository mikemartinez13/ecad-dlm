DEFAULT_CONDA_PREFIX="/home/gqs7zr/.conda/envs/ecad-dlm"  # Created by: conda env create -f /sfs/gpfs/tardis/home/gqs7zr/ai4mat/ecad/ecad-dlm.yml
PROJECT_ROOT="/sfs/gpfs/tardis/home/gqs7zr/ai4mat/ecad" # SET THIS TO YOUR PROJECT ROOT, i.e. where this file is located, as returned by `git rev-parse --show-toplevel`

# Allow scripts to find the top level python package
PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"

# Prevent large memory fragmentation during inference
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

